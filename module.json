  "license": "LICENSE",
  "readme": "README.md",
  "bugs": "https://github.com/wizzlethorpe/graft-moulinette/issues",
  "version": "0.4.0",
  "compatibility": {
    "minimum": "14",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Wizzlethorpe Labs",
      "url": "https://wizzlethorpe.com"
    }
  ],
  "esmodules": [
    "scripts/main.mjs"
  ],
  "flags": {
